{
  "name": "foreigners-studio",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node run-tauri.js",
    "tauri:build": "node run-tauri.js build && node copy-release.js",
    "tauri:build:windows": "node run-tauri.js build --bundles nsis,msi && node copy-release.js",
    "tauri:build:macos": "node run-tauri.js build --bundles dmg,app && node copy-release.js",
    "build:app": "node run-tauri.js build && node copy-release.js",
    "build:release": "node run-tauri.js build && node copy-release.js",
    "build:exe": "node run-tauri.js build --no-bundle && node copy-release.js",
    "copy-release": "node copy-release.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "javascript-obfuscator": "^5.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
