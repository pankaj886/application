{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foreigners Studio",
  "version": "1.0.30",
  "identifier": "com.foreignersstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node copy-release.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foreigners Studio",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 500,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https: http: https://*.googleusercontent.com https://lh3.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http: https://*.trycloudflare.com https://*.cloudflare.com http://127.0.0.1:* http://localhost:* https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com https://api.github.com https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; object-src 'self' blob:; frame-src 'self' blob:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50b3VjaGFibGUtcHVibGljLWtleS1wbGFjZWhvbGRlcg==",
      "endpoints": [
        "https://github.com/pankaj886/foreigners-studio-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    }
  }
}